{
  "hidden_dim": 512,
  "epochs": 50,
  "patience": 1,
  "min_delta": 0.0001,
  "max_seq_len": 200,
  "fold_idx": 0,
  "num_workers": 4,
  "lr": 0.0003,
  "weight_decay": 0.0003,
  "dropout": 0.2,
  "semantic_tokens": 8,
  "semantic_fusion_mode": "legacy",
  "semantic_modality_dropout": 0.2,
  "question_dropout": 0.1,
  "folibi_alpha": 0.0,
  "target_residual_scale": 0.6,
  "use_student_semantic_adapter": true,
  "student_semantic_adapter_mode": "legacy",
  "use_response_interaction": true,
  "response_interaction_mode": "concept",
  "response_interaction_scale": 0.15,
  "ema_decay": 0.995,
  "ema_start_epoch": 3,
  "clip_grad": 3.0,
  "strict_trimodal": true,
  "data_root": "dataset/assist2009",
  "prompt_embedding_dir": "semantic/assist2009",
  "processed_tag": "mean_retrain_v1",
  "save_dir": "Results/assist2009",
  "batch_size": 128,
  "seed": 42,
  "device": "cuda"
}
